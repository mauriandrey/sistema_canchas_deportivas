# Referencia; este archivo no se carga automáticamente.
SPRING_PROFILES_ACTIVE=local
# Genera este valor fuera del archivo. Nunca uses la clave pública de las pruebas.
JWT_SECRET=<BASE64_DE_32_O_MAS_BYTES_ALEATORIOS>
# Milisegundos, como jwt.expiration en el proyecto de clase.
JWT_EXPIRATION=3600000
JWT_ISSUER=sistema_canchas_deportivas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# DB_USERNAME y DB_PASSWORD son opcionales en local (valores académicos root/root).
# En cualquier otro entorno son obligatorios y no deben incluirse en el repositorio.
# ADMIN_INITIAL_PASSWORD solo tiene efecto si aún no existe admin.


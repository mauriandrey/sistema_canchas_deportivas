# Referencia de variables; Spring Boot NO carga este archivo automáticamente.
# Define estas variables en la terminal o en la configuración de ejecución del IDE.
SPRING_PROFILES_ACTIVE=local
# Obligatoria: genera al menos 32 bytes aleatorios y codifícalos en Base64.
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_ISSUER=sistema_canchas_deportivas
APP_TIMEZONE=America/Guayaquil
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Solo desarrollo local; fuera de local define credenciales propias.
DB_URL=jdbc:mysql://localhost:3306/sistema_canchas_deportivas?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root
# Solo se usa si no existe admin. El valor académico local por defecto es admin123.
# Fuera de local: configura una contraseña propia de al menos 12 caracteres.
ADMIN_INITIAL_PASSWORD=admin123
# Activa explícitamente las pruebas de MySQL (omitir para las pruebas sin base).
# RUN_MYSQL_TESTS=true

# Cargar catálogos solo al preparar una base inicial; false conserva los DELETE al reiniciar.
APP_INITIALIZE_CATALOGS=false
